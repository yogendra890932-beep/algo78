# Copy to .env and fill in

# Security
SECRET_KEY=change-this-to-a-long-random-string-min-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Encryption key for storing Upstox tokens at rest (32 url-safe base64 chars)
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=your-fernet-key-here

# Database (Postgres — recommended)
# Format: postgresql+asyncpg://USER:PASSWORD@HOST:PORT/DBNAME
DATABASE_URL=postgresql+asyncpg://algo_bot:algo_bot@localhost:5432/algo_bot

# (Optional) local SQLite fallback for quick testing:
# DATABASE_URL=sqlite+aiosqlite:///./algo_bot.db

# Redis — required. Shared between the web process (uvicorn) and the
# worker process (worker.py) for the command queue, live state
# snapshots, pub/sub events, and rate limiting.
# Format: redis://[:PASSWORD@]HOST:PORT/DB
REDIS_URL=redis://localhost:6379/0

# Admin default credentials (used only by init_db.py)
ADMIN_EMAIL=admin@algo_bot.com
ADMIN_PASSWORD=change-me-immediately

# Server
HOST=0.0.0.0
PORT=8000
DEBUG=false

# CORS origins (comma-separated)
ALLOWED_ORIGINS=https://optiscalper.com,http://localhost:3000

# Upstox OAuth redirect URI — register this EXACT URL in every user's
# Upstox developer app (https://account.upstox.com/developer/apps).
# Must be a publicly reachable HTTPS URL in production.
UPSTOX_REDIRECT_URI=https://optiscalper.com/api/users/upstox/callback

# Web Push (VAPID) — browser push notifications for live trade events
# (entry/exit/order alerts) even when the dashboard tab is closed.
# Generate once: python scripts/generate_vapid_keys.py
# Leave blank to disable push notifications (card hides automatically).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CLAIM_EMAIL=admin@algo_bot.com

# Upstox order webhook — set to the "Postback Secret" from your
# Upstox developer app (Webhooks section). Leave blank to skip
# signature verification (dev only — NOT safe for production).
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
# Register URL: https://yourdomain.com/api/webhook/upstox
WEBHOOK_SECRET=

# ── Razorpay — subscription payments ───────────────────────────────
# Create an app/keys at https://dashboard.razorpay.com/app/keys
# Webhook secret is configured separately under Settings → Webhooks,
# pointed at: https://yourdomain.com/api/subscription/webhook/razorpay
# Leave blank in dev — order creation returns 503 until these are set;
# signature verification logic works and is unit-tested regardless.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ── Google Sign-In ────────────────────────────────────────────────
# Create OAuth 2.0 credentials at:
#   https://console.cloud.google.com/apis/credentials
# Set Authorised redirect URI to: {APP_BASE_URL}/api/auth/google/callback
# Leave blank to disable (Google Sign-In button is hidden automatically)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Your app's public base URL (used to build redirect URIs + email links)
APP_BASE_URL=https://optiscalper.com

# ── Email verification (SMTP) ─────────────────────────────────────
# Works with Gmail App Passwords, Mailgun, SendGrid, etc.
#
# Gmail setup:
#   1. Enable 2-Step Verification at myaccount.google.com/security
#   2. Go to myaccount.google.com/apppasswords
#   3. Create an App Password for Optiscalper
#   4. Use that 16-char code as SMTP_PASSWORD (NOT your Gmail password)
#
# Leave SMTP_USER / SMTP_PASSWORD blank to skip email sending (dev mode):
# the verify URL will be printed to the server log instead.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASSWORD=your-gmail-app-password
SMTP_FROM=Optiscalper <you@gmail.com>
